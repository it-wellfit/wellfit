# Wellfit Environment Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Database configuration
WELLFIT_DB_PATH=data/wellfit_ledger.sqlite
WELLFIT_SYNC_DB_PATH=data/sync.db

# MTRIX configuration
MTRIX_DROP_DIR=spec/fixtures/mtrix/delivered
MTRIX_OUTPUT_DIR=data/mtrix_output
MTRIX_REPORT_PATH=data/mtrix_report.json

# Sync daemon configuration
SYNC_INTERVAL_SECONDS=300
SYNC_MAX_CONCURRENT=4
SYNC_RETRY_MAX_ATTEMPTS=3
SYNC_RETRY_BASE_DELAY_MS=1000
SYNC_CHECKPOINT_INTERVAL_SECONDS=60
SYNC_BANDWIDTH_LIMIT_MBPS=10.0

# Security configuration
TLS_ENABLED=false
AUTH_TOKEN=
ENCRYPTION_ENABLED=false

# Monitoring configuration
HEALTH_CHECK_PORT=8080
METRICS_ENABLED=true
LOG_LEVEL=info

# Windmill configuration (optional)
WINDMILL_DATABASE_URL=postgres://windmill:windmill@localhost:5432/windmill
WINDMILL_MODE=server

# Notification configuration (optional)
NOTIFICATION_EMAIL=
NOTIFICATION_TEAMS_WEBHOOK=
NOTIFICATION_SLACK_WEBHOOK=