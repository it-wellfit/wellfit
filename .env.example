# Wellfit environment variables (copy to .env and adjust; never commit .env)
# Target directory for cargo build artifacts (App Control requires outside repo)
CARGO_TARGET_DIR=C:\Users\you\AppData\Local\Temp\wellfit-target

# Default ledger database path (relative to working dir)
WELLFIT_DB=data\wellfit_ledger.sqlite

# Default batch identifiers
WELLFIT_BATCH_SHOPEE=BATCH-CLI-SHOPEE
WELLFIT_BATCH_REPORTS=BATCH-CLI-REPORT
WELLFIT_BATCH_MTRIX=BATCH-CLI-MTRIX
