# E.Sun Bank Integration Testing Environment
# Copy this file to .env and customize for your environment

# Development Settings
ESUN_ENV=development
ESUN_BASE_URL=https://127.0.0.1:8443
ESUN_EXTERNAL_URL=https://eospt.testesunbank.com.tw:9443
ESUN_TIMEOUT=30

# Certificate Paths (for testing)
# Bank-provided certificate (for ERP to verify bank)
ESUN_BANK_CERT=C:\certs\bank.crt
# ERP-provided client certificate (PEM)
ESUN_ERP_CERT=C:\certs\client.crt
# ERP-provided client private key (PEM)
ESUN_ERP_KEY=C:\certs\client.key
# CA certificate for chain verification
ESUN_CA_CERT=C:\certs\ca.crt

# Mock Security Settings
ESUN_MOCK_MODE=true
ESUN_MOCK_RESPONSES_PATH=C:\mocks

# WDAC Settings
ESUN_WDAC_POLICY=C:\WDAC\WellfitPolicy.bin
ESUN_WDAC_ENFORCEMENT=true

# Test Data
ESUN_TEST_VOUCHER_FILE=C:\test_data\voucher_sample.csv
ESUN_TEST_RESULT_FILE=C:\test_data\result_sample.csv

# Logging
ESUN_LOG_LEVEL=debug
ESUN_LOG_PATH=C:\logs\esun_integration.log

# SourceSystemId (agreed with bank)
ESUN_SOURCE_SYSTEM_ID=YOUR_SOURCE_SYSTEM_ID
